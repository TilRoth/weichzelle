# weichzelle global base image. Built on the host; changes need `weichzelle rebuild`.
# Harnesses and herdr come from mise (config.toml [tools]), not from here.
FROM debian:trixie-slim

RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      ca-certificates curl git gnupg jq less procps sudo unzip xz-utils \
      build-essential openssh-client locales \
 && install -dm 755 /etc/apt/keyrings \
 && curl -fsSL https://mise.jdx.dev/gpg-key.pub | gpg --dearmor -o /etc/apt/keyrings/mise.gpg \
 && echo "deb [signed-by=/etc/apt/keyrings/mise.gpg] https://mise.jdx.dev/deb stable main" \
      > /etc/apt/sources.list.d/mise.list \
 && apt-get update && apt-get install -y --no-install-recommends mise \
 && rm -rf /var/lib/apt/lists/*

# Agents run as a normal user (Claude Code refuses bypass mode as root).
RUN useradd -m -s /bin/bash -u 1000 agent \
 && echo 'agent ALL=(ALL) NOPASSWD:ALL' > /etc/sudoers.d/agent \
 && mkdir -p /work && chown agent:agent /work \
 && echo 'eval "$(mise activate bash)"' >> /home/agent/.bashrc
